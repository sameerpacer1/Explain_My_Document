# Required: Your Google Gemini API key from Google AI Studio (https://aistudio.google.com/apikey)
# Never expose this key to the browser or commit .env.local to version control.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Primary Gemini model (defaults to gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash

# Optional: Fallback model used once on 429/quota or 5xx errors (defaults to gemini-3.5-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
